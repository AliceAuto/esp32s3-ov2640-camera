# ========== 编译产物 ==========
# PlatformIO 构建目录（所有变体）
firmware/.pio/
firmware/.pio/libdeps/

# 编译输出文件
*.bin
*.elf
*.map
*.a
*.o
*.d
*.su

# ========== 日志文件 ==========
*.log

# ========== 图片/视频输出 ==========
*.png
*.jpg
*.jpeg
*.mp4
*.avi

# ========== Python 产物 ==========
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/

# ========== 工具链（体积大，本地安装） ==========
tools/*.zip
tools/package_esp32_index_local.json
tools/arduino-cli.exe

# ========== 厂商资料（体积大，无需入库） ==========
vendor/

# ========== 上位机输出 ==========
host/shots/
host/photos/

# ========== AI 模型权重（体积大，运行时下载） ==========
host/models/*.onnx

# ========== 本地凭据（不入库） ==========
firmware/src/secrets.h
