# ========== 编译产物 ==========
# Arduino/PlatformIO 构建目录（所有变体）
esp32s3_camera_serial/build/
esp32s3_camera_serial/build*/
esp32s3_camera_pio/.pio/
esp32s3_camera_pio/.pio/libdeps/

# 编译输出文件
*.bin
*.elf
*.map
*.a
*.o
*.d
*.su

# ========== 日志文件 ==========
*.log

# ========== 图片/视频输出 ==========
*.png
*.jpg
*.jpeg
*.mp4
*.avi

# ========== Python 产物 ==========
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/

# ========== 工具链（体积大，本地安装） ==========
tools/*.zip
tools/package_esp32_index_local.json
tools/arduino-cli.exe

# ========== 厂商资料（体积大，无需入库） ==========
资料/

